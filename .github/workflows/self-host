# Self-hosted Mintlify export:
name: Deploy documentation

on:
  push:
    branches: [develop, main]
  workflow_dispatch:

concurrency:
  group: deploy-docs-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  id-token: write

jobs:
  deploy-develop:
    if: github.ref == 'refs/heads/develop'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - name: Export site (Mintlify)
        run: npx --yes mint@4 export --output export.zip
      - name: Unpack export
        run: |
          mkdir -p site
          unzip -q export.zip -d site

  deploy-main:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Export site (Mintlify)
        run: npx --yes mint@4 export --output export.zip

      - name: Unpack export
        run: |
          mkdir -p site
          unzip -q export.zip -d site
